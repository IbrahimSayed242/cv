<script>
(function(){
  const nav = document.getElementById('mainNav');
  window.addEventListener('scroll', () => { nav.classList.toggle('scrolled', window.scrollY > 20); });

  const revealEls = document.querySelectorAll('.reveal, .reveal-scale');
  const io = new IntersectionObserver((entries) => {
    entries.forEach(e => { if (e.isIntersecting){ e.target.classList.add('in-view'); io.unobserve(e.target); } });
  }, { threshold: 0.15 });
  revealEls.forEach(el => io.observe(el));

  const heroVisual = document.getElementById('heroVisual');
  const browserCard = document.getElementById('browserCard');
  if (window.matchMedia('(min-width:961px)').matches){
    heroVisual.addEventListener('mousemove', (e) => {
      const rect = heroVisual.getBoundingClientRect();
      const x = (e.clientX - rect.left) / rect.width - 0.5;
      const y = (e.clientY - rect.top) / rect.height - 0.5;
      browserCard.style.transform = `rotateX(${6 - y*10}deg) rotateY(${-10 + x*16}deg)`;
    });
    heroVisual.addEventListener('mouseleave', () => { browserCard.style.transform = 'rotateX(6deg) rotateY(-10deg)'; });
  }

  const counters = document.querySelectorAll('.stat-num');
  const counterIO = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting){
        const el = entry.target;
        const target = parseInt(el.getAttribute('data-count'), 10);
        const suffix = el.getAttribute('data-suffix') || '';
        const duration = 1600;
        const start = performance.now();
        function tick(now){
          const progress = Math.min((now - start) / duration, 1);
          const eased = 1 - Math.pow(1 - progress, 3);
          el.textContent = Math.round(eased * target) + suffix;
          if (progress < 1) requestAnimationFrame(tick);
        }
        requestAnimationFrame(tick);
        counterIO.unobserve(el);
      }
    });
  }, { threshold: 0.4 });
  counters.forEach(c => counterIO.observe(c));

  const testiCards = document.querySelectorAll('.testi-card');
  const testiDots = document.getElementById('testiDots');
  let testiIndex = 0;
  testiCards.forEach((_, i) => {
    const dot = document.createElement('button');
    if (i === 0) dot.classList.add('active');
    dot.setAttribute('aria-label', 'رأي عميل ' + (i+1));
    dot.addEventListener('click', () => goToTesti(i));
    testiDots.appendChild(dot);
  });
  function goToTesti(i){
    testiCards[testiIndex].classList.remove('active');
    testiDots.children[testiIndex].classList.remove('active');
    testiIndex = i;
    testiCards[testiIndex].classList.add('active');
    testiDots.children[testiIndex].classList.add('active');
  }
  let testiTimer = setInterval(() => { goToTesti((testiIndex + 1) % testiCards.length); }, 4500);
  document.getElementById('testiTrack').addEventListener('mouseenter', () => clearInterval(testiTimer));
  document.getElementById('testiTrack').addEventListener('mouseleave', () => {
    testiTimer = setInterval(() => { goToTesti((testiIndex + 1) % testiCards.length); }, 4500);
  });

  document.querySelectorAll('.faq-item').forEach(item => {
    const q = item.querySelector('.faq-q');
    const a = item.querySelector('.faq-a');
    q.addEventListener('click', () => {
      const isOpen = item.classList.contains('open');
      document.querySelectorAll('.faq-item').forEach(other => {
        other.classList.remove('open');
        other.querySelector('.faq-q').setAttribute('aria-expanded','false');
        other.querySelector('.faq-a').style.maxHeight = null;
      });
      if (!isOpen){
        item.classList.add('open');
        q.setAttribute('aria-expanded','true');
        a.style.maxHeight = a.scrollHeight + 'px';
      }
    });
  });

  // ضع رابط الويب أب الخاص بك بعد نشر Apps Script هنا
  const SHEET_WEBAPP_URL = 'https://script.google.com/macros/s/AKfycbzYyZbtFgZYxI6yj5ddqKXTgm1_7mzsSRQzpGPbnpzrCAaGNXnuml_65OJD3PYo4OSwqw/exec';

  const leadForm = document.getElementById('leadForm');
  leadForm.addEventListener('submit', function(e){
    e.preventDefault();
    const company = document.getElementById('fcompany').value.trim();
    const name = document.getElementById('fname').value.trim();
    const phone = document.getElementById('fphone').value.trim();
    const email = document.getElementById('femail').value.trim();
    const sector = document.getElementById('fsector').value.trim();
    const message = document.getElementById('fmessage').value.trim();

    if (!company || !name || !phone || !email || !sector){
      alert('من فضلك أكمل جميع الحقول المطلوبة.');
      return;
    }

    // إرسال البيانات إلى Google Sheet عبر Apps Script
    if (!SHEET_WEBAPP_URL || SHEET_WEBAPP_URL.indexOf('PASTE_YOUR') !== -1){
      alert('لم يتم ربط الفورم بالشيت بعد. من فضلك ضع رابط Apps Script في متغير SHEET_WEBAPP_URL.');
      return;
    }

    const submitBtn = leadForm.querySelector('.form-submit');
    const originalBtnHTML = submitBtn.innerHTML;
    submitBtn.disabled = true;
    submitBtn.style.opacity = '.7';
    submitBtn.innerHTML = 'جاري الإرسال...';

    fetch(SHEET_WEBAPP_URL, {
      method: 'POST',
      mode: 'no-cors',
      headers: { 'Content-Type': 'text/plain;charset=utf-8' },
      body: JSON.stringify({ company, name, phone, email, sector, message })
    })
    .then(() => {
      showFormStatus('تم إرسال بياناتك بنجاح، سنتواصل معك في أقرب وقت. ✅', true);
      leadForm.reset();
    })
    .catch((err) => {
      console.error('تعذر إرسال البيانات إلى الشيت:', err);
      showFormStatus('حدث خطأ أثناء الإرسال، من فضلك حاول مرة أخرى. ⚠️', false);
    })
    .finally(() => {
      submitBtn.disabled = false;
      submitBtn.style.opacity = '1';
      submitBtn.innerHTML = originalBtnHTML;
    });
  });

  function showFormStatus(msg, success){
    let statusEl = document.getElementById('formStatus');
    if (!statusEl){
      statusEl = document.createElement('p');
      statusEl.id = 'formStatus';
      statusEl.style.marginTop = '16px';
      statusEl.style.textAlign = 'center';
      statusEl.style.fontWeight = '700';
      statusEl.style.fontSize = '14.5px';
      leadForm.appendChild(statusEl);
    }
    statusEl.textContent = msg;
    statusEl.style.color = success ? '#16A34A' : '#DC2626';
  }
})();
</script>

