<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>تصميم بروفايل شركات احترافي (Company Profile) | يعكس هوية شركتك</title>
<meta name="description" content="نصمم بروفايل شركات احترافي متكامل يعكس هوية علامتك التجارية ويقنع عملاءك ومستثمريك من أول نظرة. تصميم مخصص، جاهز للطباعة والعرض الرقمي. تواصل معنا عبر واتساب.">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;500;600;700;800;900&family=IBM+Plex+Sans+Arabic:wght@300;400;500;600;700&display=swap" rel="stylesheet">
<style>
  :root{
    --primary:#5B6CFF;
    --primary-2:#7C3AED;
    --secondary:#00D4FF;
    --accent:#FFB020;
    --bg:#05070D;
    --surface:#0C1020;
    --surface-2:#12172B;
    --line:rgba(255,255,255,.09);
    --line-strong:rgba(255,255,255,.16);
    --text:#F2F4F9;
    --muted:#8B93A7;
    --dark:#05070D;
  }
  *{box-sizing:border-box;}
  html{scroll-behavior:smooth;}
  body{
    margin:0;
    font-family:'IBM Plex Sans Arabic','Cairo',sans-serif;
    background:var(--bg);
    color:var(--text);
    overflow-x:hidden;
  }
  h1,h2,h3,h4,.display{font-family:'Cairo','IBM Plex Sans Arabic',sans-serif;}
  ::selection{background:var(--accent);color:#05070D;}
  a:focus-visible, button:focus-visible, input:focus-visible, textarea:focus-visible, select:focus-visible{
    outline:3px solid var(--secondary);outline-offset:2px;border-radius:4px;
  }
  @media (prefers-reduced-motion: reduce){
    *{animation-duration:0.001ms !important; animation-iteration-count:1 !important; transition-duration:0.001ms !important; scroll-behavior:auto !important;}
  }
  .container{max-width:1180px;margin:0 auto;padding:0 24px;}

  /* ---------- NAV ---------- */
  .nav{position:fixed;top:0;right:0;left:0;z-index:100;padding:16px 0;transition:all .35s ease;border-bottom:1px solid transparent;}
  .nav.scrolled{
    background:rgba(5,7,13,.75);backdrop-filter:blur(16px) saturate(160%);-webkit-backdrop-filter:blur(16px) saturate(160%);
    border-bottom:1px solid var(--line);
  }
  .nav-inner{display:flex;align-items:center;justify-content:space-between;}
  .logo{display:flex;align-items:center;gap:10px;font-weight:800;font-size:17px;color:var(--text);letter-spacing:.02em;}
  .logo::before{content:'';width:9px;height:9px;background:var(--accent);display:inline-block;box-shadow:0 0 12px var(--accent);}
  .logo-mark{width:38px;height:38px;border-radius:4px;display:flex;align-items:center;justify-content:center;overflow:hidden;}
  .logo-mark img{width:100%;height:100%;object-fit:contain;display:block;}
  .nav-links{display:flex;gap:30px;list-style:none;margin:0;padding:0;}
  .nav-links a{color:var(--muted);text-decoration:none;font-size:14px;font-weight:600;transition:color .2s ease;position:relative;}
  .nav-links a:hover{color:var(--text);}
  .nav-cta{
    display:flex;align-items:center;gap:8px;background:var(--accent);color:#05070D;padding:11px 22px;border-radius:2px;
    font-weight:800;font-size:14px;text-decoration:none;transition:transform .2s ease, box-shadow .2s ease;
    box-shadow:0 0 0 1px rgba(255,176,32,.4);
  }
  .nav-cta:hover{transform:translateY(-2px);box-shadow:0 8px 22px -6px rgba(255,176,32,.6);}

  /* ---------- BUTTONS ---------- */
  .btn{
    display:inline-flex;align-items:center;justify-content:center;gap:10px;font-weight:800;font-size:15px;
    padding:17px 30px;border-radius:2px;text-decoration:none;cursor:pointer;border:1px solid transparent;
    transition:transform .25s cubic-bezier(.2,.9,.3,1), box-shadow .25s ease, background .25s ease, border-color .25s ease;
    white-space:nowrap;letter-spacing:.01em;
  }
  .btn-primary{background:var(--accent);color:#05070D;box-shadow:0 0 0 1px rgba(255,176,32,.5), 0 16px 34px -18px rgba(255,176,32,.7);}
  .btn-primary:hover{transform:translateY(-3px);box-shadow:0 0 0 1px rgba(255,176,32,.7), 0 20px 40px -16px rgba(255,176,32,.85);}
  .btn-ghost{background:transparent;color:var(--text);border:1.5px solid var(--line-strong);}
  .btn-ghost:hover{background:rgba(255,255,255,.05);border-color:rgba(255,255,255,.3);transform:translateY(-2px);}
  .btn-big{padding:21px 42px;font-size:17px;}

  /* ---------- HERO ---------- */
  .hero{
    position:relative;padding:170px 0 110px;overflow:hidden;
    background:
      linear-gradient(rgba(255,255,255,.035) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255,255,255,.035) 1px, transparent 1px),
      radial-gradient(800px 460px at 88% -8%, rgba(124,58,237,.28), transparent 60%),
      radial-gradient(700px 500px at -8% 30%, rgba(0,212,255,.14), transparent 60%);
    background-size:44px 44px, 44px 44px, 100% 100%, 100% 100%;
  }
  .hero-grid{display:grid;grid-template-columns:1.05fr .95fr;gap:60px;align-items:center;}
  .eyebrow{
    display:inline-flex;align-items:center;gap:10px;background:var(--surface);border:1px solid var(--line-strong);
    color:var(--muted);padding:8px 16px;border-radius:2px;font-size:13px;font-weight:700;margin-bottom:26px;
  }
  .eyebrow .dot{width:7px;height:7px;border-radius:50%;background:var(--accent);box-shadow:0 0 10px var(--accent);animation:pulseDot 1.8s infinite;}
  @keyframes pulseDot{0%,100%{opacity:1;}50%{opacity:.35;}}
  .hero h1{font-size:clamp(32px,4.6vw,56px);line-height:1.18;font-weight:900;color:var(--text);margin:0 0 24px;letter-spacing:-1px;}
  .hero h1 .accent-word{color:var(--accent);position:relative;}
  .hero p.lead{font-size:18px;line-height:1.9;color:var(--muted);max-width:560px;margin:0 0 38px;}
  .hero-actions{display:flex;gap:16px;flex-wrap:wrap;margin-bottom:40px;}
  .hero-trust{display:flex;align-items:center;gap:14px;color:var(--muted);font-size:14px;font-weight:600;flex-wrap:wrap;}
  .client-logos{display:flex;align-items:center;gap:12px;flex-wrap:wrap;font-weight:800;font-size:12.5px;color:var(--muted);}
  .client-logos span{padding:7px 13px;border:1px solid var(--line);border-radius:2px;background:var(--surface);}

  .hero-visual{position:relative;perspective:1400px;}
  .browser-card{
    position:relative;border-radius:6px;overflow:hidden;background:var(--surface);border:1px solid var(--line-strong);
    box-shadow:0 40px 90px -30px rgba(0,0,0,.7), 0 0 60px -20px rgba(124,58,237,.35);
    transform:rotateX(6deg) rotateY(-10deg);transition:transform .4s ease-out;will-change:transform;
  }
  .browser-bar{display:flex;align-items:center;gap:8px;padding:12px 16px;background:#080a13;border-bottom:1px solid var(--line);}
  .browser-bar span{width:9px;height:9px;border-radius:50%;background:#2a2f3f;}
  .browser-bar span:nth-child(1){background:#FF5F56;}
  .browser-bar span:nth-child(2){background:#FFBD2E;}
  .browser-bar span:nth-child(3){background:#27C93F;}
  .browser-url{margin-inline-start:12px;background:#161b2e;color:var(--muted);font-size:11px;padding:5px 14px;border-radius:2px;flex:1;max-width:240px;font-family:monospace;direction:ltr;text-align:left;}
  .browser-card img{display:block;width:100%;height:auto;}
  .float-card{
    position:absolute;background:rgba(12,16,32,.9);backdrop-filter:blur(14px);-webkit-backdrop-filter:blur(14px);
    border:1px solid var(--line-strong);border-radius:4px;padding:14px 18px;box-shadow:0 20px 44px -16px rgba(0,0,0,.6);
    display:flex;align-items:center;gap:10px;animation:floaty 5s ease-in-out infinite;
  }
  .float-card .num{font-weight:900;font-size:19px;color:var(--accent);line-height:1;}
  .float-card .lbl{font-size:11px;color:var(--muted);font-weight:600;}
  .float-1{top:-22px;left:-30px;animation-delay:0s;}
  .float-2{bottom:8px;right:-26px;animation-delay:1.4s;}
  @keyframes floaty{0%,100%{transform:translateY(0);}50%{transform:translateY(-12px);}}

  .reveal{opacity:0;transform:translateY(26px);transition:opacity .7s ease, transform .7s cubic-bezier(.2,.7,.3,1);}
  .reveal.in-view{opacity:1;transform:translateY(0);}
  .reveal-scale{opacity:0;transform:scale(.94);transition:opacity .6s ease, transform .6s cubic-bezier(.2,.7,.3,1);}
  .reveal-scale.in-view{opacity:1;transform:scale(1);}

  section{padding:110px 0;scroll-margin-top:90px;}
  .section-head{max-width:640px;margin:0 auto 56px;text-align:center;}
  .section-tag{display:inline-block;color:var(--accent);font-weight:800;font-size:13px;letter-spacing:.12em;background:var(--surface);border:1px solid var(--line);padding:6px 14px;border-radius:2px;margin-bottom:18px;font-family:monospace;}
  .section-head h2{font-size:clamp(28px,3.6vw,42px);font-weight:900;color:var(--text);margin:0 0 14px;line-height:1.25;letter-spacing:-.5px;}
  .section-head p{color:var(--muted);font-size:16px;line-height:1.8;margin:0;}

  /* ---------- FEATURES ---------- */
  .features-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:1px;background:var(--line);border:1px solid var(--line);}
  .feature-card{
    background:var(--surface);padding:36px 28px;
    transition:background .3s ease;position:relative;overflow:hidden;
  }
  .feature-card::before{
    content:'';position:absolute;top:0;right:0;width:0;height:2px;background:var(--accent);transition:width .35s ease;
  }
  .feature-card:hover{background:var(--surface-2);}
  .feature-card:hover::before{width:100%;}
  .feature-icon{width:50px;height:50px;border-radius:2px;background:rgba(255,176,32,.08);border:1px solid rgba(255,176,32,.25);display:flex;align-items:center;justify-content:center;margin-bottom:20px;color:var(--accent);}
  .feature-card h3{font-size:18px;font-weight:800;color:var(--text);margin:0 0 10px;}
  .feature-card p{font-size:14.5px;line-height:1.8;color:var(--muted);margin:0;}

  /* ---------- STATS ---------- */
  .stats-section{background:var(--surface);border:1px solid var(--line-strong);border-radius:6px;margin:0 24px;position:relative;overflow:hidden;}
  .stats-section::before{
    content:'';position:absolute;inset:0;
    background:radial-gradient(600px 300px at 15% 0%, rgba(124,58,237,.22), transparent 60%),
               radial-gradient(600px 300px at 85% 100%, rgba(0,212,255,.16), transparent 60%);
  }
  .stats-inner{position:relative;padding:74px 24px;}
  .stats-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:20px;max-width:1100px;margin:0 auto;text-align:center;}
  .stats-grid > div{border-right:1px solid var(--line);}
  .stats-grid > div:last-child{border-right:none;}
  .stat-num{
    font-size:clamp(34px,4.2vw,48px);font-weight:900;color:var(--accent);line-height:1;margin-bottom:10px;font-family:monospace;
  }
  .stat-num.solid{color:var(--secondary);}
  .stat-lbl{color:var(--muted);font-size:14px;font-weight:600;}

  /* ---------- CLIENT WORK GRID ---------- */
  .clients-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:2px;background:var(--line);border:1px solid var(--line);}
  .client-card{
    position:relative;overflow:hidden;background:var(--surface);text-decoration:none;display:block;
    transition:transform .35s cubic-bezier(.2,.7,.3,1);
  }
  .client-card:hover{transform:translateY(-4px);z-index:2;box-shadow:0 30px 50px -20px rgba(0,0,0,.7);}
  .client-card img{width:100%;height:100%;object-fit:cover;display:block;aspect-ratio:3/4;filter:grayscale(35%) contrast(1.05);transition:transform .6s cubic-bezier(.2,.7,.3,1), filter .4s ease;}
  .client-card:hover img{transform:scale(1.06);filter:grayscale(0%) contrast(1.05);}
  .client-overlay{
    position:absolute;inset:0;background:linear-gradient(to top, rgba(5,7,13,.95) 0%, rgba(5,7,13,.4) 45%, transparent 70%);
    display:flex;flex-direction:column;justify-content:flex-end;padding:20px;
  }
  .client-name{color:#fff;font-weight:800;font-size:15.5px;margin-bottom:8px;}
  .client-link-row{display:flex;align-items:center;gap:8px;color:var(--accent);font-size:12px;font-weight:700;
    opacity:0;transform:translateY(6px);transition:opacity .3s ease, transform .3s ease;}
  .client-card:hover .client-link-row{opacity:1;transform:translateY(0);}
  .client-badge{
    position:absolute;top:14px;left:14px;background:rgba(5,7,13,.85);border:1px solid var(--line-strong);
    color:var(--text);font-size:10.5px;font-weight:800;padding:5px 10px;border-radius:2px;display:flex;align-items:center;gap:5px;
  }

  /* ---------- TIMELINE ---------- */
  .timeline{position:relative;max-width:880px;margin:0 auto;}
  .timeline::before{content:'';position:absolute;top:0;bottom:0;right:31px;width:1px;background:var(--line-strong);}
  .t-step{display:flex;gap:26px;padding-bottom:52px;position:relative;}
  .t-step:last-child{padding-bottom:0;}
  .t-num{
    flex-shrink:0;width:64px;height:64px;border-radius:2px;background:var(--surface);border:1px solid var(--line-strong);
    display:flex;align-items:center;justify-content:center;font-weight:900;font-size:22px;color:var(--accent);font-family:monospace;
    position:relative;z-index:1;
  }
  .t-content{padding-top:10px;}
  .t-content h3{font-size:18.5px;font-weight:800;color:var(--text);margin:0 0 8px;}
  .t-content p{color:var(--muted);font-size:14.5px;line-height:1.8;margin:0;max-width:520px;}

  /* ---------- TESTIMONIALS ---------- */
  .testi-wrap{position:relative;max-width:760px;margin:0 auto;}
  .testi-track{position:relative;min-height:220px;}
  .testi-card{
    position:absolute;inset:0;background:var(--surface);border:1px solid var(--line-strong);border-radius:6px;padding:44px 40px;text-align:center;
    opacity:0;transform:translateY(14px) scale(.98);
    transition:opacity .5s ease, transform .5s ease;pointer-events:none;
  }
  .testi-card.active{opacity:1;transform:translateY(0) scale(1);pointer-events:auto;}
  .stars{color:var(--accent);font-size:18px;letter-spacing:3px;margin-bottom:16px;}
  .testi-card p.quote{font-size:18px;line-height:1.85;color:var(--text);font-weight:600;margin:0 0 22px;}
  .testi-person{display:flex;align-items:center;justify-content:center;gap:12px;}
  .testi-avatar{width:42px;height:42px;border-radius:2px;background:rgba(255,176,32,.12);border:1px solid rgba(255,176,32,.3);display:flex;align-items:center;justify-content:center;color:var(--accent);font-weight:800;font-size:15px;}
  .testi-name{font-weight:800;font-size:14.5px;color:var(--text);}
  .testi-role{font-size:12.5px;color:var(--muted);}
  .testi-dots{display:flex;justify-content:center;gap:8px;margin-top:28px;}
  .testi-dots button{width:8px;height:8px;border-radius:50%;border:1px solid var(--line-strong);background:transparent;cursor:pointer;transition:background .3s ease, width .3s ease;padding:0;}
  .testi-dots button.active{background:var(--accent);border-color:var(--accent);width:24px;border-radius:4px;}

  /* ---------- FAQ ---------- */
  .faq-list{max-width:760px;margin:0 auto;display:flex;flex-direction:column;gap:1px;background:var(--line);border:1px solid var(--line);}
  .faq-item{background:var(--surface);overflow:hidden;transition:background .25s ease;}
  .faq-item.open{background:var(--surface-2);}
  .faq-q{display:flex;align-items:center;justify-content:space-between;padding:22px 24px;cursor:pointer;font-weight:700;font-size:15.5px;color:var(--text);background:none;border:none;width:100%;text-align:right;font-family:inherit;}
  .faq-q .chev{transition:transform .3s ease;flex-shrink:0;color:var(--accent);}
  .faq-item.open .faq-q .chev{transform:rotate(180deg);}
  .faq-a{max-height:0;overflow:hidden;transition:max-height .35s ease;}
  .faq-a p{margin:0;padding:0 24px 24px;color:var(--muted);font-size:14.5px;line-height:1.85;}

  /* ---------- CTA ---------- */
  .cta-section{position:relative;margin:0 24px;border-radius:6px;overflow:hidden;background:linear-gradient(135deg,var(--primary-2),var(--primary));padding:84px 40px;text-align:center;border:1px solid var(--line-strong);}
  .cta-section::before{content:'';position:absolute;inset:0;background:radial-gradient(500px 300px at 90% -10%, rgba(255,176,32,.3), transparent 60%);}
  .cta-section h2{position:relative;color:#fff;font-size:clamp(28px,3.8vw,42px);font-weight:900;margin:0 0 16px;letter-spacing:-.5px;}
  .cta-section p{position:relative;color:rgba(255,255,255,.85);font-size:16.5px;margin:0 0 36px;}
  .btn-white{background:#fff;color:#05070D;box-shadow:0 16px 34px -14px rgba(0,0,0,.5);}
  .btn-white:hover{transform:translateY(-3px);}

  /* ---------- FORM ---------- */
  .form-section{background:var(--bg);}
  .form-wrap{max-width:680px;margin:0 auto;background:var(--surface);border:1px solid var(--line-strong);border-radius:6px;padding:48px;}
  .form-grid{display:grid;grid-template-columns:1fr 1fr;gap:18px;}
  .field{display:flex;flex-direction:column;gap:8px;margin-bottom:18px;min-width:0;}
  .field.full{grid-column:1/-1;}
  .field label{font-size:13px;font-weight:700;color:var(--muted);}
  .field input, .field select, .field textarea{
    border:1.5px solid var(--line-strong);border-radius:2px;padding:13px 16px;font-family:inherit;font-size:16px;
    background:#080a13;color:var(--text);transition:border-color .2s ease, box-shadow .2s ease;width:100%;min-height:50px;
    -webkit-appearance:none;appearance:none;
  }
  .field select{
    background-image:url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='%23FFB020' stroke-width='2.4' stroke-linecap='round' stroke-linejoin='round'><path d='M6 9l6 6 6-6'/></svg>");
    background-repeat:no-repeat;background-position:left 14px center;background-size:18px;padding-left:42px;cursor:pointer;
  }
  .field input:focus, .field select:focus, .field textarea:focus{border-color:var(--accent);box-shadow:0 0 0 3px rgba(255,176,32,.15);outline:none;}
  .field textarea{resize:vertical;min-height:110px;}
  .form-submit{width:100%;justify-content:center;margin-top:6px;min-height:54px;}

  /* ---------- FOOTER ---------- */
  footer{background:#03040A;color:var(--muted);padding:60px 0 28px;border-top:1px solid var(--line);}
  .footer-grid{display:grid;grid-template-columns:1.4fr 1fr 1fr;gap:40px;margin-bottom:44px;}
  .footer-logo{display:flex;align-items:center;gap:10px;color:var(--text);font-weight:800;font-size:18px;margin-bottom:14px;}
  footer p{font-size:14px;line-height:1.8;max-width:320px;}
  .footer-col h4{color:var(--text);font-size:14px;font-weight:700;margin:0 0 16px;letter-spacing:.04em;}
  .footer-col ul{list-style:none;margin:0;padding:0;display:flex;flex-direction:column;gap:10px;}
  .footer-col a{color:var(--muted);text-decoration:none;font-size:14px;transition:color .2s ease;}
  .footer-col a:hover{color:var(--accent);}
  .footer-bottom{border-top:1px solid var(--line);padding-top:24px;display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:12px;font-size:13px;color:var(--muted);}

  /* ---------- FLOATING WHATSAPP ---------- */
  .wa-float{
    position:fixed;bottom:26px;left:26px;z-index:200;width:60px;height:60px;border-radius:50%;background:#25D366;
    display:flex;align-items:center;justify-content:center;box-shadow:0 14px 30px -8px rgba(37,211,102,.6);text-decoration:none;
    animation:waPulse 2.6s infinite;
  }
  @keyframes waPulse{
    0%{box-shadow:0 0 0 0 rgba(37,211,102,.55), 0 14px 30px -8px rgba(37,211,102,.6);}
    70%{box-shadow:0 0 0 14px rgba(37,211,102,0), 0 14px 30px -8px rgba(37,211,102,.6);}
    100%{box-shadow:0 0 0 0 rgba(37,211,102,0), 0 14px 30px -8px rgba(37,211,102,.6);}
  }

  @media (max-width:960px){
    .nav-links{display:none;}
    .hero-grid{grid-template-columns:1fr;}
    .hero{padding-top:130px;}
    .hero-visual{max-width:440px;margin:60px auto 0;}
    .features-grid{grid-template-columns:repeat(2,1fr);}
    .stats-grid{grid-template-columns:repeat(2,1fr);row-gap:32px;}
    .stats-grid > div{border-right:none;}
    .clients-grid{grid-template-columns:repeat(3,1fr);}
    .footer-grid{grid-template-columns:1fr 1fr;}
  }
  @media (max-width:620px){
    section{padding:70px 0;}
    .features-grid{grid-template-columns:1fr;}
    .stats-grid{grid-template-columns:1fr 1fr;}
    .clients-grid{grid-template-columns:repeat(2,1fr);}
    .form-grid{grid-template-columns:1fr;}
    .form-wrap{padding:30px 22px;}
    .footer-grid{grid-template-columns:1fr;}
    .cta-section{padding:56px 24px;}
    .hero-actions{flex-direction:column;align-items:stretch;}
    .browser-card{transform:none;}
  }
</style>
</head>
<body>

<!-- ================= NAV ================= -->
<nav class="nav" id="mainNav">
  <div class="container nav-inner">
    <div class="logo">
      بروفايل برو للشركات
    </div>
