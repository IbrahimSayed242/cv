<!doctype html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>لوحة مراجعة المحادثات</title>
<script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2.45.4/dist/umd/supabase.js"></script>
<style>
:root{--bg:#f6f7f9;--card:#fff;--tx:#1b1f24;--mut:#6b7280;--bd:#e5e7eb;--pri:#2563eb;--ok:#16a34a;--bad:#dc2626;--warn:#d97706;--cust:#eef2ff;--page:#ecfdf5}
@media(prefers-color-scheme:dark){:root{--bg:#0f1115;--card:#181b21;--tx:#e8eaed;--mut:#9aa3af;--bd:#2a2f38;--pri:#60a5fa;--cust:#1e2540;--page:#12301f}}
*{box-sizing:border-box}body{margin:0;font-family:system-ui,"Segoe UI",Tahoma,sans-serif;background:var(--bg);color:var(--tx);font-size:15px}
.hide{display:none!important}.mut{color:var(--mut)}small{color:var(--mut);font-size:12px}
input,textarea,button{font:inherit;color:inherit}
select{padding:8px;border:1px solid var(--bd);border-radius:8px;background:var(--card);color:inherit;font:inherit;max-width:100%}
input,textarea{width:100%;padding:9px 10px;border:1px solid var(--bd);border-radius:8px;background:var(--card);margin-bottom:8px}
textarea{min-height:200px;resize:vertical;line-height:1.6}
button{padding:8px 14px;border:0;border-radius:8px;background:var(--pri);color:#fff;cursor:pointer}
button.ghost{background:transparent;color:var(--tx);border:1px solid var(--bd)}button.red{background:var(--bad)}
header{display:flex;gap:12px;align-items:center;padding:10px 16px;background:var(--card);border-bottom:1px solid var(--bd);flex-wrap:wrap}
nav{display:flex;gap:6px;flex:1}nav button{background:transparent;color:var(--tx);border:1px solid var(--bd)}nav button.on{background:var(--pri);color:#fff;border-color:var(--pri)}
.box{max-width:340px;margin:12vh auto;padding:22px;background:var(--card);border:1px solid var(--bd);border-radius:12px}
.grid{display:grid;grid-template-columns:320px 1fr;gap:14px;padding:14px;align-items:start}
@media(max-width:800px){.grid{grid-template-columns:1fr}}
aside,main,.card{background:var(--card);border:1px solid var(--bd);border-radius:12px;padding:12px}
#list{max-height:70vh;overflow:auto}
.it{padding:10px;border-radius:8px;cursor:pointer;display:grid;grid-template-columns:1fr auto;gap:2px 8px;border-bottom:1px solid var(--bd)}
.it:hover,.it.on{background:var(--cust)}.it small{grid-column:1/3}
.badge{padding:1px 8px;border-radius:99px;font-size:12px;background:var(--bd);height:fit-content}
.badge.good{background:#dcfce7;color:#166534}.badge.warn{background:#fef3c7;color:#92400e}.badge.bad{background:#fee2e2;color:#991b1b}
.msgs{display:flex;flex-direction:column;gap:8px;max-height:46vh;overflow:auto;padding:4px}
.m{max-width:78%;padding:8px 12px;border-radius:12px;white-space:pre-wrap;word-break:break-word}
.m.customer{background:var(--cust);align-self:flex-start}.m.page{background:var(--page);align-self:flex-end}
.m small{display:block;margin-bottom:2px}
.rev{border-top:1px solid var(--bd);padding:10px 0}
.err{margin:4px 0;padding:6px 8px;border-inline-start:3px solid var(--warn);background:var(--bg);border-radius:4px}
.sec{padding:14px;max-width:900px;margin:auto}
pre{white-space:pre-wrap;background:var(--bg);padding:8px;border-radius:8px;max-height:140px;overflow:auto;margin:6px 0}
.row{display:flex;gap:8px;flex-wrap:wrap;align-items:center}
#toast{position:fixed;bottom:16px;inset-inline:16px;max-width:420px;margin:auto;background:#111;color:#fff;padding:10px 14px;border-radius:8px;display:none;text-align:center}
</style>
</head>
<body>

<div id="login" class="box hide">
  <h3>تسجيل الدخول</h3>
  <input id="em" type="email" placeholder="الإيميل" autocomplete="username">
  <input id="pw" type="password" placeholder="كلمة السر" autocomplete="current-password">
  <button id="bl" style="width:100%">دخول</button>
</div>

<div id="app" class="hide">
  <header>
    <b>لوحة مراجعة المحادثات</b>
    <nav><button data-t="convs" class="on">المحادثات</button><button data-t="prompts">البرومبتات</button></nav>
    <button id="lo" class="ghost">خروج</button>
  </header>

  <section id="convs"><div class="grid">
    <aside>
      <input id="q" placeholder="بحث بالاسم">
      <label class="mut"><input type="checkbox" id="att" style="width:auto;margin:0 0 0 6px"> تحتاج انتباه فقط</label>
      <div id="list"></div>
    </aside>
    <main id="detail"><p class="mut">اختار محادثة من القايمة</p></main>
  </div></section>

  <section id="prompts" class="hide"><div class="sec">
    <div class="card">
      <h3 id="ptitle">إضافة برومبت جديد</h3>
      <input id="pn" placeholder="اسم البرومبت (مثلاً: تقييم الجودة العام)">
      <textarea id="pt" placeholder="اكتب معايير المراجعة هنا. استخدم {{conversation}} مكان المحادثة. شكل الإخراج (JSON) بيتضاف تلقائياً."></textarea>
      <small>لو ما كتبتش {{conversation}} المحادثة هتتضاف في آخر البرومبت.</small>
      <div class="row" style="margin-top:8px"><button id="ps">حفظ</button><button id="pc" class="ghost hide">إلغاء التعديل</button></div>
    </div>
    <h3>البرومبتات المحفوظة</h3>
    <div id="plist"></div>
  </div></section>
</div>
<div id="toast"></div>

<script>
// ⚙️ حط بيانات مشروعك من Supabase: Project Settings -> API (استخدم anon key، مش service_role)
const SUPABASE_URL = 'https://qsahksxxsbgqffalltjm.supabase.co';
const SUPABASE_ANON_KEY = 'eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InFzYWhrc3h4c2JncWZmYWxsdGptIiwicm9sZSI6ImFub24iLCJpYXQiOjE3OTMyMzkyMjksImV4cCI6MjEwODgxNTIyOX0.KNPwJuocgSGKWgwO8YvEnFZSBmwu0A1y6rpOyhatHPQ';

const sb = supabase.createClient(SUPABASE_URL, SUPABASE_ANON_KEY);
const $ = s => document.querySelector(s);
const esc = s => String(s ?? '').replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
const fmt = d => d ? new Date(d).toLocaleString('ar-EG', {timeZone:'Africa/Cairo'}) : '';
let convs = [], editId = null, curId = null;

function toast(t){const e=$('#toast');e.textContent=t;e.style.display='block';clearTimeout(toast.t);toast.t=setTimeout(()=>e.style.display='none',3500)}
const fail = (e) => { console.error(e); toast('خطأ: ' + (e.message || e)); };

// ---------- الدخول ----------
async function init(){
  const {data:{session}} = await sb.auth.getSession();
  show(!!session);
}
function show(on){ $('#login').classList.toggle('hide', on); $('#app').classList.toggle('hide', !on); if(on){loadConvs();loadPrompts();} }
$('#bl').onclick = async () => {
  const {error} = await sb.auth.signInWithPassword({email:$('#em').value.trim(), password:$('#pw').value});
  error ? fail(error) : show(true);
};
$('#lo').onclick = async () => { await sb.auth.signOut(); show(false); };
document.querySelectorAll('nav button').forEach(b => b.onclick = () => {
  document.querySelectorAll('nav button').forEach(x => x.classList.toggle('on', x === b));
  ['convs','prompts'].forEach(id => $('#'+id).classList.toggle('hide', id !== b.dataset.t));
});

// ---------- المحادثات ----------
async function loadConvs(){
  const {data, error} = await sb.from('conversations_overview').select('*').order('last_message_at',{ascending:false}).limit(300);
  if (error) return fail(error);
  convs = data; renderList();
}
function badge(c){
  if (c.last_score == null) return '<span class="badge">—</span>';
  const cls = c.last_needs_attention || c.last_score <= 5 ? 'bad' : c.last_score <= 7 ? 'warn' : 'good';
  return `<span class="badge ${cls}">${esc(c.last_score)}/10</span>`;
}
function renderList(){
  const q = $('#q').value.trim().toLowerCase(), att = $('#att').checked;
  const items = convs.filter(c => (!q || (c.name||c.id).toLowerCase().includes(q)) && (!att || c.last_needs_attention || (c.last_score != null && c.last_score <= 5)));
  $('#list').innerHTML = items.map(c => `<div class="it ${c.id===curId?'on':''}" data-id="${esc(c.id)}"><b>${esc(c.name||c.id)}</b>${badge(c)}<small>${fmt(c.last_message_at)} · ${esc(c.messages_count)} رسالة</small></div>`).join('') || '<p class="mut">لا توجد محادثات</p>';
}
$('#q').oninput = $('#att').onchange = renderList;
$('#list').onclick = e => { const it = e.target.closest('.it'); if (it) openConv(it.dataset.id); };

async function openConv(id){
  curId = id; renderList();
  $('#detail').innerHTML = '<p class="mut">جاري التحميل…</p>';
  const [m, r] = await Promise.all([
    sb.from('messages').select('*').eq('customer_id', id).order('created_at',{ascending:true}).limit(500),
    sb.from('ai_reviews').select('*, review_prompts(name)').eq('customer_id', id).order('created_at',{ascending:false}).limit(20)
  ]);
  if (m.error || r.error) return fail(m.error || r.error);
  const c = convs.find(x => x.id === id) || {};
  $('#detail').innerHTML = `<h3>${esc(c.name||id)} <small>${esc(id)}</small></h3>
    <div class="row" style="margin-bottom:10px"><select id="rp">${(window._p||[]).map(p => `<option value="${p.id}" ${p.is_active?'selected':''}>${esc(p.name)}${p.is_active?' (المفعّل)':''}</option>`).join('')}</select><button id="rv" data-id="${esc(id)}">🔍 راجع الآن</button></div>
    <div class="msgs">${m.data.map(x => `<div class="m ${x.sender_role}"><small>${x.sender_role==='page'?'الصفحة/الموديريتور':'العميل'} · ${esc(x.sender_name||'')} · ${fmt(x.created_at)}</small>${esc(x.text||'[مرفق أو رسالة بدون نص]')}</div>`).join('')}</div>
    <h3>مراجعات الذكاء الاصطناعي</h3>
    ${r.data.map(v => `<div class="rev"><div class="row"><b>${esc(v.score)}/10</b>${v.needs_attention?'<span class="badge bad">تحتاج انتباه</span>':''}<small>${fmt(v.created_at)} · ${esc(v.review_prompts?.name||'برومبت محذوف')} · ${esc(v.model||'')}</small></div>
      ${(v.errors||[]).map(e => `<div class="err"><b>${esc(e.type)}</b>: ${esc(e.why)}${e.quote?`<br><small>«${esc(e.quote)}»</small>`:''}</div>`).join('')}
      ${v.improved_reply?`<small>الصياغة المقترحة:</small><pre>${esc(v.improved_reply)}</pre>`:''}</div>`).join('') || '<p class="mut">لا توجد مراجعات بعد</p>'}`;
}

// ---------- البرومبتات ----------
async function loadPrompts(){
  const {data, error} = await sb.from('review_prompts').select('*').order('created_at',{ascending:false});
  if (error) return fail(error);
  window._p = data;
  $('#plist').innerHTML = data.map(p => `<div class="card" style="margin-bottom:10px"><div class="row"><b>${esc(p.name)}</b>${p.is_active?'<span class="badge good">مفعّل</span>':''}<small>${fmt(p.created_at)}</small></div>
    <pre>${esc(p.prompt_text)}</pre>
    <div class="row">${p.is_active?'':`<button data-a="act" data-id="${p.id}">تفعيل</button>`}<button class="ghost" data-a="edit" data-id="${p.id}">تعديل</button><button class="red" data-a="del" data-id="${p.id}">حذف</button></div></div>`).join('') || '<p class="mut">لا توجد برومبتات</p>';
}
$('#plist').onclick = async e => {
  const b = e.target.closest('button'); if (!b) return;
  const id = b.dataset.id, p = window._p.find(x => x.id === id);
  if (b.dataset.a === 'act') { const {error} = await sb.rpc('set_active_prompt', {p_id:id}); if (error) return fail(error); toast('تم التفعيل'); loadPrompts(); }
  if (b.dataset.a === 'edit') { editId = id; $('#pn').value = p.name; $('#pt').value = p.prompt_text; $('#ptitle').textContent = 'تعديل برومبت'; $('#pc').classList.remove('hide'); scrollTo(0,0); }
  if (b.dataset.a === 'del' && confirm('حذف البرومبت؟ المراجعات القديمة هتفضل محفوظة.')) { const {error} = await sb.from('review_prompts').delete().eq('id', id); if (error) return fail(error); loadPrompts(); }
};
function resetForm(){ editId = null; $('#pn').value = ''; $('#pt').value = ''; $('#ptitle').textContent = 'إضافة برومبت جديد'; $('#pc').classList.add('hide'); }
$('#pc').onclick = resetForm;
$('#ps').onclick = async () => {
  const name = $('#pn').value.trim(), prompt_text = $('#pt').value.trim();
  if (!name || !prompt_text) return toast('اكتب الاسم والبرومبت');
  const {error} = editId ? await sb.from('review_prompts').update({name, prompt_text}).eq('id', editId) : await sb.from('review_prompts').insert({name, prompt_text});
  if (error) return fail(error);
  toast('تم الحفظ'); resetForm(); loadPrompts();
};

// ---------- تشغيل المراجعة يدوياً ----------
$('#detail').onclick = async e => {
  const b = e.target.closest('#rv'); if (!b) return;
  const id = b.dataset.id; b.disabled = true; b.textContent = 'جاري المراجعة…';
  const {error} = await sb.functions.invoke('review-conversation', {body:{customer_id:id, prompt_id:$('#rp').value || null}});
  if (error) {
    let msg = error.message;
    try { const j = await error.context.json(); if (j.error) msg = j.error; } catch {}
    b.disabled = false; b.textContent = '🔍 راجع الآن'; return fail(new Error(msg));
  }
  toast('تمت المراجعة'); await loadConvs(); openConv(id);
};

init();
</script>
</body>
</html>
